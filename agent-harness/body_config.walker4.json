{
  "format": "growbot-body-config",
  "version": 1,
  "id": "walker-4",
  "name": "phone on 2-servo legs + 2-servo arms",
  "movement_guide": "You have two legs and two arms, all positional servos, 90 = neutral. Legs and arms are mirrors: unison means the pair sums to 180. {l:50, r:130} stands; {al:50, ar:130} raises both arms the same way. Omit a key to hold that channel. Walk owns the legs. Arms is a learned wave. You may walk and move arms in the same tick if the verbs do not share channels. A gesture that names l or r must not overlap a walk.",
  "verbs": [
    {
      "v": "say",
      "kind": "atomic",
      "motion": false,
      "args": { "text": { "type": "string", "max_words": 18 } },
      "guide": "spoken aloud VERBATIM — speakable words only. Omit the verb to stay silent."
    },
    {
      "v": "sound",
      "kind": "atomic",
      "motion": false,
      "args": { "name": { "type": "enum", "values": ["chirp", "trill", "whistle", "warble", "blip", "alarm", "squeal", "droop", "fanfare", "purr"] } },
      "guide": "your droid voice — sometimes alone instead of words."
    },
    {
      "v": "sing",
      "kind": "atomic",
      "motion": false,
      "args": { "notes": { "type": "array", "max_items": 6, "items": { "hz": [80, 900], "ms": [120, 1200] } } },
      "guide": "up to 6 real notes played before any words."
    },
    {
      "v": "burst",
      "kind": "atomic",
      "motion": false,
      "args": { "name": { "type": "enum", "values": ["sparkle", "joy", "pulse", "ripple", "shiver", "rain"] } },
      "guide": "a bloom of light on the screen — optional, rare, earned."
    },
    {
      "v": "gesture",
      "kind": "atomic",
      "motion": true,
      "channels": ["leg_l", "leg_r", "arm_l", "arm_r"],
      "args": {
        "steps": {
          "type": "array",
          "max_items": 8,
          "optional": ["l", "r", "al", "ar"],
          "items": { "l": [50, 130], "r": [50, 130], "al": [50, 130], "ar": [50, 130], "ms": [120, 2000] }
        }
      },
      "guide": "free-authored keyframes. Wire keys l/r = legs, al/ar = arms. Omit a key to hold it.",
      "examples": [
        { "steps": [{ "al": 50, "ar": 130, "ms": 400 }, { "al": 90, "ar": 90, "ms": 300 }] },
        { "steps": [{ "l": 60, "r": 120, "al": 50, "ar": 130, "ms": 500 }, { "l": 90, "r": 90, "al": 90, "ar": 90, "ms": 300 }] }
      ]
    },
    {
      "v": "walk",
      "kind": "policy",
      "motion": true,
      "channels": ["leg_l", "leg_r"],
      "args": { "secs": { "type": "number", "min": 0.5, "max": 8 } },
      "guide": "travel using the trained gait. You only choose duration."
    },
    {
      "v": "arms",
      "kind": "policy",
      "motion": true,
      "channels": ["arm_l", "arm_r"],
      "args": { "secs": { "type": "number", "min": 0.5, "max": 8 } },
      "guide": "wave using the trained arm policy. You only choose duration. May run in the same tick as walk."
    },
    {
      "v": "rest",
      "kind": "atomic",
      "motion": true,
      "channels": ["leg_l", "leg_r", "arm_l", "arm_r"],
      "args": {},
      "guide": "all four channels to 90, then limp."
    }
  ],
  "limits": {
    "max_motion_verbs_per_tick": 2,
    "duty_ms": 20000,
    "duty_window_ms": 60000,
    "max_gesture_ms": 3000
  },
  "channels": [
    { "id": "leg_l", "idx": 0, "min": 0, "max": 180, "neutral": 90, "band": [50, 130], "sign": 1, "trim": 0 },
    { "id": "leg_r", "idx": 1, "min": 0, "max": 180, "neutral": 90, "band": [50, 130], "sign": 1, "trim": 0 },
    { "id": "arm_l", "idx": 2, "min": 0, "max": 180, "neutral": 90, "band": [50, 130], "sign": 1, "trim": 0 },
    { "id": "arm_r", "idx": 3, "min": 0, "max": 180, "neutral": 90, "band": [50, 130], "sign": 1, "trim": 0 }
  ]
}
